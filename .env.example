# ==============================================================================
# Mercora Platform — Root Environment Configuration Template (.env.example)
# ==============================================================================

# Database Configuration
DATABASE_URL=sqlite:///./backend/merchant_commerce.db
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
API_V1_STR=/api/v1
PROJECT_NAME="Mercora AI Merchant Commerce Platform"

# LLM Intelligence Providers (Gemini Primary, Groq Resilient Failover)
PRIMARY_LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
MOCK_AI_MODE=false

# Razorpay Test Mode Configuration (Test Keys Only — Never Real Secrets)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=rzp_test_your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=rzp_test_your_webhook_secret_here
